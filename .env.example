# ---- Server ----
PORT=4000
NODE_ENV=development
# MongoDB connection string (Atlas free tier works)
MONGODB_URI=mongodb://127.0.0.1:27017/prepkit
# Secret used to sign session tokens (long random string)
SESSION_SECRET=change-me
# Session lifetime in days
SESSION_TTL_DAYS=7
# Origin of the web app, for CORS + cookies
WEB_ORIGIN=http://localhost:3000

# ---- LLM (any provider with a free tier) ----
# groq | gemini  (add adapters in server/src/lib/llm.js)
LLM_PROVIDER=groq
LLM_MODEL=
LLM_API_KEY=
# Free tiers limit tokens/minute: keep these conservative
LLM_MAX_RETRIES=5
LLM_TOKENS_PER_MINUTE=6000

# ---- Retrieval ----
# Max pages fetched per company site
CRAWL_MAX_PAGES=8
# Min delay between requests to the same host (ms)
CRAWL_DELAY_MS=1000
# Reject private/loopback addresses. Batch runs against localhost fixtures set this to false.
BLOCK_PRIVATE_ADDRESSES=true

# ---- Web (set in web/.env.local or the host's dashboard) ----
# Public URL of the API
NEXT_PUBLIC_API_URL=http://localhost:4000
