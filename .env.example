# ---- Server ----
PORT=4000
NODE_ENV=development
# MongoDB connection string (Atlas free tier works)
MONGODB_URI=mongodb://127.0.0.1:27017/prepkit
# Secret used to sign session tokens (long random string)
SESSION_SECRET=change-me
# Session lifetime in days
SESSION_TTL_DAYS=7
# Origin of the web app, for CORS + cookies
WEB_ORIGIN=http://localhost:3000

# ---- LLM (any OpenAI-compatible provider with a free tier) ----
# Presets: gemini (default) | groq | openai-compatible (then set LLM_BASE_URL + LLM_MODEL yourself)
LLM_PROVIDER=gemini
# API key from your provider's console (Google AI Studio for gemini, console.groq.com for groq)
LLM_API_KEY=
# Optional overrides. Defaults per preset: gemini -> gemini-2.5-flash, groq -> openai/gpt-oss-120b.
# Free-tier limits are per MODEL and change: check your console and adjust the two limits below.
# LLM_MODEL=
# LLM_BASE_URL=
# LLM_REQUESTS_PER_MINUTE=
# LLM_TOKENS_PER_MINUTE=
# Retries on 429/5xx/timeouts (exponential backoff, honours the provider's retry hint)
LLM_MAX_RETRIES=4
# If the provider says "retry in N s" with N above this, the quota counts as exhausted and the call fails fast
LLM_MAX_WAIT_MS=90000
LLM_TIMEOUT_MS=60000
# Caps hidden "thinking" tokens on reasoning models; leave empty to not send the parameter
LLM_REASONING_EFFORT=low

# ---- Background jobs (kit generation) ----
# Kits generated in parallel. Keep 1 on free tiers: all jobs share one LLM token budget anyway.
JOB_CONCURRENCY=1
# A job that runs longer than this is marked failed (JOB_TIMEOUT). The pipeline gets 80% of it as a soft
# budget and skips optional steps (flashcards, late categories, nice-to-have gap rounds) when running late.
JOB_TIMEOUT_MS=600000
# A job interrupted by a restart is retried up to this many times, then marked failed (JOB_INTERRUPTED)
JOB_MAX_ATTEMPTS=3
# Kits a single user may have generating at once (protects the shared free-tier budget)
JOB_MAX_ACTIVE_PER_USER=5
# `npm run evaluate`: total time budget shared by all cases (the brief allows 15 minutes for five cases)
EVALUATE_BUDGET_MS=780000

# ---- Retrieval ----
# Max pages fetched per company site
CRAWL_MAX_PAGES=8
# Min delay between requests to the same host (ms); a site's robots.txt Crawl-delay can raise it
CRAWL_DELAY_MS=1000
# Per-request timeout (ms), max response size (bytes), retries on timeout/5xx/429 (exponential backoff)
CRAWL_TIMEOUT_MS=8000
CRAWL_MAX_BYTES=1500000
CRAWL_RETRIES=2
# Search Hacker News for public interview discussion (set false to run fully offline)
DISCUSSION_ENABLED=true
# Private/loopback address blocking. LEAVE UNSET: defaults to true in production and false elsewhere,
# so `npm run evaluate` can crawl company sites served from localhost. Never set false in production.
# BLOCK_PRIVATE_ADDRESSES=

# ---- Web (set in web/.env.local or the host's dashboard) ----
# Public URL of the API
NEXT_PUBLIC_API_URL=http://localhost:4000
